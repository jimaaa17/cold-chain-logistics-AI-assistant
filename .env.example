# Copy to .env and fill in the values. Never commit .env.

# --- SQL Server ---------------------------------------------------------------
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=master

# Admin login: used by the data loader and by the audit-log screen.
SQL_ADMIN_USER=sa
SQL_ADMIN_PASSWORD=

# Read-only login used by the agent (created by BE/sql/setup_security_view.sql).
# Leave the password empty: scripts/rotate_agent_password.py --yes generates and saves it.
SQL_AGENT_USER=USR_FDE_RO
SQL_AGENT_PASSWORD=

# --- LLM ------------------------------------------------------------------------
# GEMINI, OPENAI or OLLAMA
AGENT_LLM=GEMINI
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OLLAMA_MODEL=qwen2.5:7b

# --- SOP retrieval (Pinecone) -----------------------------------------------------
PINECONE_API_KEY=
# LOCAL (BAAI/bge-m3, runs on this machine) or OPENAI
EMBEDDINGS_PROVIDER=LOCAL
# PINECONE_INDEX_NAME=fde-sop-index-local
# PINECONE_NAMESPACE=sop

# --- Agent behaviour (defaults shown) ----------------------------------------------
# Only readings newer than this can trigger SOP actions.
# EVIDENCE_FRESHNESS_HOURS=24
# SQL_MAX_ROWS=10
# RAG_TOP_K=5
# Who decides each step: code, shadow or model
# ROUTING_MODE=code
# THRESHOLDS_MODE=code
# VERIFICATION_MODE=code

# --- Audit and tracing ------------------------------------------------------------
# AUDIT_ENABLED=true
# Langfuse also needs: pip install langfuse
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
